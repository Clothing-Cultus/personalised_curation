# secrets
.env
.env.local
.env.*
!.env.example

# deploy credentials (EC2 SSH keys, deploy keys) - NEVER commit
*.pem
*.key
*.ppk
id_rsa*
id_ed25519*
*.pub

# credentials reference. The real file lives OUTSIDE every repo at
#   Cultus/Code/important files/cultus-pc-credentials.md
# These patterns are a backstop in case a copy is ever dropped in here.
cultus-pc-credentials.md
CREDENTIALS.md
credentials.md
secrets.*
*.secrets

# python
__pycache__/
*.pyc
pcenv/
venv/
.venv/

# ml artifacts & caches (regenerated by the pipeline)
ml/artifacts/
ml/cache/

# runtime data
data/spool/
data/exports/
data/cv_proposals/
*.done

# supabase local (keep config.toml + migrations; ignore local state)
supabase/.temp/
supabase/.branches/
supabase/.env

# generated prod schema dump (regenerate via `supabase db dump`; not source,
# and keeps the full prod data model out of git). Remove this line if you'd
# rather commit it for turnkey local/staging setup.
prod_schema.sql
