# Copy to .env and fill in. NEVER commit .env.
# Secrets live here; every tunable number lives in core/config.py.

# --- Supabase (same project the Django server uses: "Cultus Prod") ---
SUPABASE_URL=https://wfvfozmnxhlggqefigci.supabase.co
# Service role key — Supabase dashboard → Project Settings → API.
# Used for server-side reads (and writes only once ENABLE_DB_WRITES=True in config).
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Curator API ---
# The single static shared secret the calling server sends as "X-Internal-Key"
# on every request (spec §6.1). Leave empty to disable auth (local dev only).
INTERNAL_KEY=

# Optional overrides
# PC_ENV=production    # production disables POST /api/reset_user (staging-only)
# REFERENCE_DATA_DIR=/abs/path/to/past data     # defaults to ../past data
